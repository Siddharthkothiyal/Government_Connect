
# ============================================================
# FRONTEND — PUBLIC environment variables (Vite exposes VITE_* to browser)
# ============================================================
# NOTE: This variable is SAFE to expose to the browser because it's just the API URL
# (anyone using your website can see network requests in DevTools anyway.
#
# LOCAL DEV: Run your backend on port 5000 (see backend/.env -> PORT=5000)
# PRODUCTION: This should be your deployed backend URL, e.g.:
#   VITE_API_BASE_URL=https://my-government-connect-backend.onrender.com/api
# ============================================================
VITE_API_BASE_URL=http://localhost:5000/api
