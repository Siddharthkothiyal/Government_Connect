# ============================================================
# BACKEND — SERVER-SIDE ONLY SECRETS
# NEVER commit this file to GitHub. NEVER expose these to frontend code.
# ============================================================

# ---------- REQUIRED (database) ----------
# PostgreSQL connection string.
# Local example (Windows, PostgreSQL installed locally):
#   DATABASE_URL="postgresql://postgres:YourPassword@localhost:5432/schemewise?schema=public"
#
# Cloud example (Supabase, Neon, Render, Railway, ElephantSQL, etc.):
#   DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"
DATABASE_URL="postgresql://username:password@localhost:5432/schemewise?schema=public"

# ---------- REQUIRED (JWT / authentication) ----------
# Used to sign login tokens (access tokens).
# CRITICAL: Must be long and random. At least 32 characters.
# See the main guide for how to generate one locally (node crypto).
# Example:  JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars!!!"
JWT_SECRET="your-super-secret-jwt-key-change-me-please-32chars-min"

# ---------- REQUIRED (AI) ----------
# Google Gemini API key for bilingual summaries and AI chat.
# Get it from: https://aistudio.google.com/apikey
# Variable name expected by backend/src/config/env.ts is: GEMINI_API_KEY
GEMINI_API_KEY="your-gemini-api-key-here"

# ---------- OPTIONAL ----------
# Backend server port. Defaults to 5000 if missing.
# NOTE: Frontend's VITE_API_BASE_URL must match this port when running locally.
PORT=5000

# Node environment: development | production | test
NODE_ENV="development"

# Frontend origin allowed to call this API.
FRONTEND_URL="http://localhost:5173"
